# Configurações de Segurança - Lanchonete
# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=4000

# Origens permitidas para CORS (separadas por vírgula)
# Ex: http://localhost:3000,https://meudominio.com
CORS_ORIGIN=http://localhost:4000

# Segredo JWT (gere um com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# IMPORTANTE: Em produção, use um segredo forte e único!
JWT_SECRET=

# Configurações de Banco de Dados (SQLite - arquivo local)
DB_PATH=./lanchonete.db

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de Log
LOG_LEVEL=info