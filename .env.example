# Configuração Local - Lanchonete
# Copie este arquivo para .env e ajuste conforme necessário

# Servidor
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
TZ=America/Sao_Paulo

# CORS (origens permitidas em produção)
# CORS_ORIGIN=http://localhost:4000,http://192.168.1.100:4000

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Obtenha em: https://supabase.com/dashboard/project/<SEU_PROJETO>/settings/api
# Project URL (ex: https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Anon/Public Key (para cliente frontend)
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Service Role Key (para backend - NÃO EXPOR NO FRONTEND!)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Database URL (para conexão direta PostgreSQL)
# Obtenha em: Settings > Database > Connection string > URI
# Opções:
#  - Direta (DB Host): postgresql://postgres:[SENHA]@db.<PROJETO>.supabase.co:5432/postgres  (precisa SSL)
#  - Pooler (recomendado Vercel/serverless - porta 6543, max 5 conexões): 
#    postgresql://postgres.<PROJETO>:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# O código normaliza automaticamente postgres.<ref> e ativa SSL quando URL contém supabase.co/com
DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres

# Alternativa: SUPABASE_DB_URL (mesmo que DATABASE_URL)
# SUPABASE_DB_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres

# Cron demo (opcional): segredo para permitir reset manual fora do Vercel Cron
# CRON_SECRET=gere-um-segredo-forte
# Para testar: curl -H "Authorization: Bearer $CRON_SECRET" https://sua-demo.vercel.app/api/cron/reset-demo

# ============================================
# JWT SECRET (para tokens customizados)
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=gere-um-segredo-forte-aqui-com-64-caracteres-hex

# ============================================
# BACKUP (Supabase)
# - Free: sem PITR. Faça dump manual: supabase db dump -f backup.sql  ou pg_dump $DATABASE_URL
# - Pro: ative PITR em Dashboard > Database > Backups (point-in-time recovery)
# - Cardápio JSONs locais (cardapio_dados.json, cardápio/) não versionados - exporte via Admin > Config se precisar
# ============================================

# ============================================
# CONFIGURAÇÕES PADRÃO (podem ser alteradas pelo painel admin)
# ============================================
LOJA_NOME=Minha Lanchonete
LOJA_TELEFONE=
PIX_TIPO=cpf
PIX_CHAVE=
PIX_NOME=Lanchonete