{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "npm ci",
  "devCommand": "echo 'Use vercel dev directly'",
  "regions": ["gru1"],
  "functions": {
    "api/auth.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/produtos.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/categorias.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/adicionais.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/clientes.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/bairros.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/mesas.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/comandas.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/config.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] },
    "api/pedidos.ts": { "maxDuration": 30, "includeFiles": ["lib/**/*"] }
  },
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/garcom/(.*)", "destination": "/garcom.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}