{
  "name": "lanchonete",
  "version": "2.0.0",
  "description": "Lanchonete system - Supabase + Vercel",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "echo 'Static build - no build step'",
    "lint": "eslint . --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate:sqlite": "tsx scripts/migrate-sqlite-to-pg.ts",
    "migrate:auth": "tsx scripts/migrate-auth.ts",
    "migrate:files": "tsx scripts/migrate-files.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "vitest run",
    "postinstall": "echo 'Run db:generate manually'"
  },
  "dependencies": {
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/better-sqlite3": "^9.6.0",
    "@upstash/ratelimit": "^1.1.0",
    "@upstash/redis": "^1.28.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.29.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
