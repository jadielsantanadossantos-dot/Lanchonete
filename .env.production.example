# Railway Production Environment Variables
# Configure these in Railway Dashboard → Settings → Environment

# Server
NODE_ENV=production
PORT=4000

# Security - GENERATE NEW SECRETS FOR PRODUCTION!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# CORS - Replace with your Railway domain after first deploy
# Format: https://your-app-name.up.railway.app
CORS_ORIGIN=https://your-app-name.up.railway.app

# Database - SQLite file path (Railway volume mount at /data)
DB_PATH=/data/lanchonete.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info